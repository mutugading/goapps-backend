# =============================================================================
# Payroll Service — Environment Variables (local dev)
# Copy to .env.local and fill in credentials. .env.local is gitignored.
# The Makefile does `include .env.local; export`, so these override config.yaml
# via Viper's env binding. NOT used in Kubernetes — staging/prod inject config
# via K8s Secrets + ConfigMaps (see goapps-infra). This file is LOCAL ONLY.
# =============================================================================

# --- App ---
APP_ENV=development                 # development | staging | production
LOG_LEVEL=debug                     # debug | info | warn | error

# --- Payroll Postgres (payroll-postgres, port 5437 — wired from T002) ---
# config.yaml defaults already match these; uncomment only to override.
# PAYROLL_DATABASE_HOST=localhost
# PAYROLL_DATABASE_PORT=5437
# PAYROLL_DATABASE_USER=payroll_app
# PAYROLL_DATABASE_PASSWORD=payroll_app123
# PAYROLL_DATABASE_NAME=payroll

# --- Tracing ---
# TRACING_ENABLED=true
# JAEGER_ENDPOINT=localhost:4317
