# iam-service on the v2 local stack (docker-compose.v2.yaml): runtime role via PgBouncer.
# Dev-only values. Switch: make v2-env-on (copies to services/<svc>/.env.local).
DATABASE_HOST=localhost
DATABASE_PORT=6440
DATABASE_USER=iam_app
DATABASE_PASSWORD=dev_iam_app
DATABASE_NAME=iam_db
DATABASE_SSLMODE=disable

# per-service `make migrate-up/down` (owner role, direct :5440, v2 migration table). Prefer `make v2-migrate` from the repo root (also re-applies grants).
DATABASE_URL=postgres://iam_owner:dev_iam_owner@localhost:5440/iam_db?sslmode=disable&x-migrations-table=schema_migrations_iam
